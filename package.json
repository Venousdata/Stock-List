{
  "name": "james-howell-stock-list",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "files": [
    "public",
    "src",
    "FEEDBACK.md",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "npm-shrinkwrap.json",
    ".nvmrc",
    ".editorconfig",
    ".oxlintrc.json",
    ".oxfmtrc.json"
  ],
  "scripts": {
    "prepack": "node --input-type=commonjs -e \"require('node:fs').copyFileSync('package-lock.json', 'npm-shrinkwrap.json')\"",
    "postpack": "node --input-type=commonjs -e \"require('node:fs').rmSync('npm-shrinkwrap.json', { force: true })\"",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && oxlint --deny-warnings .",
    "start": "vite --open",
    "build": "npm run typecheck && vite build",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
